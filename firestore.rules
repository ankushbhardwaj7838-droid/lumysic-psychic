rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bankush014@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAstrologer() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/astrologers/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection heartbeat endpoint
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      // Regular users can only register with default role 'user', preventing self-privilege escalation
      allow create: if isValidId(userId) && isOwner(userId) && (
        request.resource.data.role == 'user' || isAdmin()
      );
      // Users cannot change their own role unless admin
      allow update: if isValidId(userId) && (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin();
    }

    // Admin role directory
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isAdmin();
      allow write: if isValidId(adminId) && isAdmin();
    }

    // Astrologer role directory
    match /astrologers/{astrologerId} {
      allow get: if isValidId(astrologerId) && (request.auth.uid == astrologerId || isAdmin());
      allow list: if isAdmin();
      allow write: if isValidId(astrologerId) && isAdmin();
    }
  }
}
